  <text><body>
    <div type="poem" xml:id="the-enchantment" n="L16134">
      <head>The Enchantment</head>
      <idno type="URN">urn:laurel:eng:otway.obev-thomas-otway.pg66619:the-enchantment</idno><idno type="laurel-id">L16134</idno><note type="metre">common measure</note>
      <lg type="stanza" n="1" rhyme="-a-a">
        <l n="1" real="xxxxxx-+" met="-+-+-+-+">I did but look and love awhile,</l>
        <l n="2" real="xxxxx+-" met="+-+-+-+">’Twas but for one half-hour;</l>
        <l n="3" real="xx-+xxxx" met="-+-+-+-+">Then to resist I had no will,</l>
        <l n="4" real="xxxxx+-" met="+-+-+-+">And now I have no power.</l>
      </lg>
      <lg type="stanza" n="2" rhyme="-a-a">
        <l n="5" real="xxxxxxxx" met="-+-+-+-+">To sigh and wish is all my ease;</l>
        <l n="6" real="xxxx-+" met="-+-+-+">Sighs which do heat impart</l>
        <l n="7" real="-+xxx+-x" met="-+-+-+-+">Enough to melt the coldest ice,</l>
        <l n="8" real="x+-xxx" met="-+-+-+">Yet cannot warm your heart.</l>
      </lg>
      <lg type="stanza" n="3" rhyme="abab">
        <l n="9" real="xxx+-xxx" met="-+-+-+-+">O would your pity give my heart</l>
        <l n="10" real="x+-xxx" met="-+-+-+">One corner of your breast,</l>
        <l n="11" real="xxxxx+-x" met="-+-+-+-+">’Twould learn of yours the winning art,</l>
        <l n="12" real="x+-xxx" met="-+-+-+">And quickly steal the rest.</l>
      </lg>
    </div>
