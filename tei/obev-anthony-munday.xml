    <div type="poem" xml:id="beauty-bathing" n="L15973">
      <head>Beauty Bathing</head>
      <idno type="URN">urn:laurel:eng:munday.obev-anthony-munday.pg66619:beauty-bathing</idno><idno type="laurel-id">L15973</idno><note type="metre">iambic trimeter</note>
      <lg type="stanza" n="1" rhyme="abab-c-c--">
        <l n="1" real="+-x+-xxx" met="--+-+-+-">BEAUTY sat bathing by a spring,</l>
        <l n="2" real="x+-xxxx" met="-+-+-+-">Where fairest shades did hide her;</l>
        <l n="3" real="xxxxxxxx" met="--+-+-+-">The winds blew calm, the birds did sing,</l>
        <l n="4" real="xxxx-+x" met="-+-+-+-">The cool streams ran beside her.</l>
        <l n="5" real="x+-x-+xx" met="--+-+-+-">My wanton thoughts enticed mine eye</l>
        <l n="6" real="xxxx-+-" met="-+-+-+-">To see what was forbidden:</l>
        <l n="7" real="x+-+--xx" met="--+-+-+-">But better memory said Fie;</l>
        <l n="8" real="xx-+-xxx" met="--+-+-+-">So vain desire was chidden--</l>
        <l n="9" real="xxxxxx" met="-+-+-+">Hey nonny nonny O!</l>
        <l n="10" real="xxxxx" met="+-+-+">Hey nonny nonny!</l>
      </lg>
      <lg type="stanza" n="2" rhyme="a-a-bcbc">
        <l n="11" real="xxx+-xxx" met="--+-+-+-">Into a slumber then I fell,</l>
        <l n="12" real="xx-x-+-" met="-+-+-+-">And fond imagination</l>
        <l n="13" real="xxxxxxx" met="-+-+-+-">Seemèd to see, but could not tell,</l>
        <l n="14" real="x+-xx+-" met="-+-+-+-">Her feature or her fashion:</l>
        <l n="15" real="xxxxxxxx" met="--+-+-+-">But ev’n as babes in dreams do smile,</l>
        <l n="16" real="x+xxx+-" met="-+-+-+-">And sometimes fall a-weeping,</l>
        <l n="17" real="xxxxxxxx" met="--+-+-+-">So I awaked as wise that while</l>
        <l n="18" real="xxxxx+-" met="-+-+-+-">As when I fell a-sleeping.</l>
      </lg>
    </div>
