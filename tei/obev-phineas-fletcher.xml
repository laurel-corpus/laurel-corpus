    <div type="poem" xml:id="a-litany" n="L16035">
      <head>A Litany</head>
      <idno type="URN">urn:laurel:eng:fletcher-p.obev-phineas-fletcher.pg66619:a-litany</idno><idno type="laurel-id">L16035</idno><note type="metre">iambic trimeter</note>
      <lg type="stanza" n="1" rhyme="ab-c-b-c-a-a">
        <l n="1" real="xxxx" met="-+-+">Drop, drop, slow tears,</l>
        <l n="2" real="xxx+--x" met="-+-+-+-">And bathe those beauteous feet</l>
        <l n="3" real="xxx+-" met="+-+-+">Which brought from Heaven</l>
        <l n="4" real="xxxxxx" met="-+-+-+">The news and Prince of Peace:</l>
        <l n="5" real="xxxx" met="-+-+">Cease not, wet eyes,</l>
        <l n="6" real="x+-x-+" met="-+-+-+">His mercy to entreat;</l>
        <l n="7" real="xxx+-" met="+-+-+">To cry for vengeance</l>
        <l n="8" real="xx+-x" met="+-+-+">Sin doth never cease.</l>
        <l n="9" real="xxxx" met="-+-+">In your deep floods</l>
        <l n="10" real="xxxxxx" met="-+-+-+">Drown all my faults and fears;</l>
        <l n="11" real="xxxx" met="-+-+">Nor let His eye</l>
        <l n="12" real="xxxxxx" met="-+-+-+">See sin, but through my tears.</l>
      </lg>
    </div>
