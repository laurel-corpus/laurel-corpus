  <text><body>
    <div type="poem" xml:id="song" n="L16148">
      <head>Song</head>
      <idno type="URN">urn:laurel:eng:parnell.obev-thomas-parnell.pg66619:song</idno><idno type="laurel-id">L16148</idno><note type="metre">anapaestic tetrameter</note>
      <lg type="stanza" n="1" rhyme="aabab">
        <l n="1" real="xx+--+" met="--+--+">When thy beauty appears</l>
        <l n="2" real="xx+-xx" met="--+--+">In its graces and airs</l>
        <l n="3" real="xxxx+-xxxxx" met="-+--+--+--+">All bright as an angel new dropp’d from the sky,</l>
        <l n="4" real="x+-xxxxxxxx" met="-+--+--+--+">At distance I gaze and am awed by my fears:</l>
        <l n="5" real="x+-x+-xx" met="-+--+--+">So strangely you dazzle my eye!</l>
      </lg>
      <lg type="stanza" n="2" rhyme="aabab">
        <l n="6" real="xxxxx" met="-+--+">But when without art</l>
        <l n="7" real="xxxx-+" met="--+--+">Your kind thoughts you impart,</l>
        <l n="8" real="xxxxx+-x+--x" met="--+--+--+--+">When your love runs in blushes through every vein;</l>
        <l n="9" real="xxxxxxxxxxxx" met="--+--+--+--+">When it darts from your eyes, when it pants in your heart,</l>
        <l n="10" real="xxxxx+--+" met="+--+--+-+">Then I know you’re a woman again.</l>
      </lg>
      <lg type="stanza" n="3" rhyme="aabab">
        <l n="11" real="xx+-xx" met="--+--+">There’s a passion and pride</l>
        <l n="12" real="x+-xx-+" met="--+--+-">In our sex (she replied),</l>
        <l n="13" real="xxxx+-xxxxx" met="-+--+--+--+">And thus, might I gratify both, I would do:</l>
        <l n="14" real="xx+--+xx+--+" met="--+--+--+--+">Still an angel appear to each lover beside,</l>
        <l n="15" real="xxxx+-xx" met="-+--+--+">But still be a woman to you.</l>
      </lg>
    </div>
  </body></text>
