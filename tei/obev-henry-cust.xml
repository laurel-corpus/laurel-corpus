  <text><body>
    <div type="poem" xml:id="non-nobis" n="L16287">
      <head>Non Nobis</head>
      <idno type="URN">urn:laurel:eng:cust.obev-henry-cust.pg66619:non-nobis</idno><idno type="laurel-id">L16287</idno><note type="metre">iambic pentameter</note>
      <lg type="stanza" n="1" rhyme="-abb-a">
        <l n="1" real="xxxxxx" met="--+-+-">Not unto us, O Lord,</l>
        <l n="2" real="xxxxx+-xxx" met="-+-+-+-+-+">Not unto us the rapture of the day,</l>
        <l n="3" real="xxxxxx-+-+" met="-+-+-+-+-+">The peace of night, or love’s divine surprise,</l>
        <l n="4" real="xxxxxxx+--x" met="-+-+-+-+-+-">High heart, high speech, high deeds ’mid honouring eyes;</l>
        <l n="5" real="xxxx" met="--+-">For at Thy word</l>
        <l n="6" real="xxx+--+" met="-+-+-+-">All these are taken away.</l>
      </lg>
      <lg type="stanza" n="2" rhyme="abccab">
        <l n="7" real="xxxxxx" met="--+-+-">Not unto us, O Lord:</l>
        <l n="8" real="xxxxxxxxxxx" met="-+-+-+-+-+-">To us thou givest the scorn, the scourge, the scar,</l>
        <l n="9" real="xxxxx+--xx" met="-+-+-+-+-+">The ache of life, the loneliness of death,</l>
        <l n="10" real="x-+----+--xx" met="--+-+-+-+-+-">The insufferable sufficiency of breath;</l>
        <l n="11" real="xxxx" met="--+-">And with Thy sword</l>
        <l n="12" real="xxx+-x" met="--+-+-">Thou piercest very far.</l>
      </lg>
      <lg type="stanza" n="3" rhyme="a---a-">
        <l n="13" real="xxxxxx" met="--+-+-">Not unto us, O Lord:</l>
        <l n="14" real="xxxxxxxxx+-" met="-+-+-+-+-+-">Nay, Lord, but unto her be all things given--</l>
        <l n="15" real="xxxxxxxxx+-" met="-+-+-+-+-+-">My light and life and earth and sky be blasted--</l>
        <l n="16" real="xxxxxxxxx+-" met="-+-+-+-+-+-">But let not all that wealth of loss be wasted:</l>
        <l n="17" real="xx-+" met="--+-">Let Hell afford</l>
        <l n="18" real="x+-xx+-" met="-+-+-+-">The pavement of her Heaven!</l>
      </lg>
    </div>
