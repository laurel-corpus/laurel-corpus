  <text><body>
    <div type="poem" xml:id="the-shepherd-boy-sings-in-the-valley-of-humiliat" n="L16114">
      <head>The Shepherd Boy sings in the Valley of Humiliation</head>
      <idno type="URN">urn:laurel:eng:bunyan.obev-john-bunyan.pg66619:the-shepherd-boy-sings-in-the-valley-of-humiliat</idno><idno type="laurel-id">L16114</idno><note type="metre">common measure</note>
      <lg type="stanza" n="1" rhyme="-a-a">
        <l n="1" real="xxxxxxxx" met="--+-+-+-">He that is down needs fear no fall,</l>
        <l n="2" real="xxxxxx" met="-+-+-+">He that is low, no pride;</l>
        <l n="3" real="xxx+-+-x" met="--+-+-+-">He that is humble ever shall</l>
        <l n="4" real="xxxxxx" met="-+-+-+">Have God to be his guide.</l>
      </lg>
      <lg type="stanza" n="2" rhyme="abab">
        <l n="5" real="xx+-xxxx" met="--+-+-+-">I am content with what I have,</l>
        <l n="6" real="+-xxxx" met="-+-+-+">Little be it or much:</l>
        <l n="7" real="xx-+-xxx" met="--+-+-+-">And, Lord, contentment still I crave,</l>
        <l n="8" real="xxxxxx" met="-+-+-+">Because Thou savest such.</l>
      </lg>
      <lg type="stanza" n="3" rhyme="-a-a">
        <l n="9" real="+-xxx+-x" met="--+-+-+-">Fullness to such a burden is</l>
        <l n="10" real="xxx+--" met="-+-+-+">That go on pilgrimage:</l>
        <l n="11" real="x+-x-+-x" met="--+-+-+-">Here little, and hereafter bliss,</l>
        <l n="12" real="xxxxxx" met="-+-+-+">Is best from age to age.</l>
      </lg>
    </div>
