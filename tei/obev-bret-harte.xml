  <text><body>
    <div type="poem" xml:id="what-the-bullet-sang" n="L16253">
      <head>What the Bullet sang</head>
      <idno type="URN">urn:laurel:eng:harte.obev-bret-harte.pg66619:what-the-bullet-sang</idno><idno type="laurel-id">L16253</idno><note type="metre">iambic trimeter</note>
      <lg type="stanza" n="1" rhyme="abbbaaab">
        <l n="1" real="xxx-+-" met="-+-+-+">O joy of creation,</l>
        <l n="2" real="xx" met="-+">To be!</l>
        <l n="3" real="x+-xx" met="+-+-+">O rapture, to fly</l>
        <l n="4" real="xxx" met="-+-">And be free!</l>
        <l n="5" real="xx+-xxx" met="-+-+-+-">Be the battle lost or won,</l>
        <l n="6" real="xxxxxxx" met="-+-+-+-">Though its smoke shall hide the sun,</l>
        <l n="7" real="xxxxxxx" met="-+-+-+-">I shall find my love--the one</l>
        <l n="8" real="xxx" met="-+-">Born for me!</l>
      </lg>
      <lg type="stanza" n="2" rhyme="ababcccb">
        <l n="9" real="xxxxxxx" met="-+-+-+-">I shall know him where he stands</l>
        <l n="10" real="x-+" met="-+-">All alone,</l>
        <l n="11" real="xx+-xxx" met="-+-+-+-">With the power in his hands</l>
        <l n="12" real="xxx" met="-+-">Not o’erthrown;</l>
        <l n="13" real="xxxxxxx" met="-+-+-+-">I shall know him by his face,</l>
        <l n="14" real="xxxxxxx" met="-+-+-+-">By his godlike front and grace;</l>
        <l n="15" real="xxxxxxx" met="-+-+-+-">I shall hold him for a space</l>
        <l n="16" real="xxx" met="-+-">All my own!</l>
      </lg>
      <lg type="stanza" n="3" rhyme="ababcccb">
        <l n="17" real="xxxxxx" met="-+-+-+">It is he--O my love!</l>
        <l n="18" real="xx" met="-+">So bold!</l>
        <l n="19" real="xxxxxx" met="-+-+-+">It is I--all thy love</l>
        <l n="20" real="-+" met="-+">Foretold!</l>
        <l n="21" real="xxxxxxx" met="-+-+-+-">It is I--O love, what bliss!</l>
        <l n="22" real="xx+-xxx" met="-+-+-+-">Dost thou answer to my kiss?</l>
        <l n="23" real="x+xxxx" met="-+-+-+">O sweetheart! what is this</l>
        <l n="24" real="xxxx" met="--+-">Lieth there so cold?</l>
      </lg>
    </div>
