  <text><body>
    <div type="poem" xml:id="bridal-song" n="L15981">
      <head>Bridal Song</head>
      <idno type="URN">urn:laurel:eng:chapman.obev-george-chapman.pg66619:bridal-song</idno><idno type="laurel-id">L15981</idno><note type="metre">iambic tetrameter</note>
      <lg type="stanza" n="1" rhyme="abab-c-c">
        <l n="1" real="xxxxxxxx" met="-+-+-+-+">O come, soft rest of cares! come, Night!</l>
        <l n="2" real="x+-+-+-+-" met="-+-+-+-+-">Come, naked Virtue’s only tire,</l>
        <l n="3" real="xx+-xxx" met="+-+-+-+">The reapèd harvest of the light</l>
        <l n="4" real="xxxxx+-+-" met="-+-+-+-+-">Bound up in sheaves of sacred fire.</l>
        <l n="5" real="xxxx" met="--+-">Love calls to war:</l>
        <l n="6" real="xx-+" met="--+-">Sighs his alarms,</l>
        <l n="7" real="xxxx" met="--+-">Lips his swords are,</l>
        <l n="8" real="xxxx" met="--+-">The field his arms.</l>
      </lg>
      <lg type="stanza" n="2" rhyme="abab-c-c">
        <l n="9" real="xxxxx+-x" met="-+-+-+-+">Come, Night, and lay thy velvet hand</l>
        <l n="10" real="x+--xxxxx" met="-+-+-+-+-">On glorious Day’s outfacing face;</l>
        <l n="11" real="xxxxx-+" met="+-+-+-+">And all thy crownèd flames command</l>
        <l n="12" real="x+-x+-+-x" met="-+-+-+-+-">For torches to our nuptial grace.</l>
        <l n="13" real="xxxx" met="--+-">Love calls to war:</l>
        <l n="14" real="xx-+" met="--+-">Sighs his alarms,</l>
        <l n="15" real="xxxx" met="--+-">Lips his swords are,</l>
        <l n="16" real="xxxx" met="--+-">The field his arms.</l>
      </lg>
    </div>
